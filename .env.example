# Copy to .env and fill in. Generate secrets with: yarn gen:secrets
# See docs/01-architecture.md §1.6 for every variable.

# Required
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=v1
HASHING_SECRET=

# Optional (defaults shown)
# PORT=3000
# DB_FILE=data/db.json
# PROCESSOR_LATENCY_MS=300
# PROCESSOR_FAILURE_RATE=0
# WORKER_CONCURRENCY=5
# WEBHOOK_ALLOW_INSECURE_URLS=false
# RETENTION_DAYS=7
# DB_WARN_SIZE_MB=20
# LOG_LEVEL=info
