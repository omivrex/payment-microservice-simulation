# Run `yarn gen:secrets` to create .env from this file with placeholder secrets filled in,
# or copy it to .env and fill the secrets in yourself.
# See docs/01-architecture.md §1.6 for every variable.

# Required
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=v1
HASHING_SECRET=

# Optional (defaults shown)
# PORT=3000
# DB_FILE=data/db.json
# PROCESSOR_LATENCY_MS=300
# PROCESSOR_FAILURE_RATE=0
# WORKER_CONCURRENCY=5
# WEBHOOK_ALLOW_INSECURE_URLS=false
# RETENTION_DAYS=7
# DB_WARN_SIZE_MB=10
# RATE_LIMIT_SIGNUP_PER_HOUR=5
# RATE_LIMIT_TOKENS_PER_MINUTE=60
# RATE_LIMIT_GENERAL_PER_MINUTE=300
# LOG_LEVEL=info
