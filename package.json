{
  "name": "payment-service",
  "version": "0.1.0",
  "description": "Microservice that simulates card payment processing, backed by a file-based JSON database",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "gen:secrets": "tsx scripts/generate-secrets.ts",
    "test": "node --import tsx --import ./test/setup.ts --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --import ./test/setup.ts --test --test-reporter=spec \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --import ./test/setup.ts --test --test-reporter=spec \"test/integration/**/*.test.ts\"",
    "test:api": "node --import tsx --import ./test/setup.ts --test --test-reporter=spec \"test/api/**/*.test.ts\"",
    "test:process": "node --import tsx --import ./test/setup.ts --test --test-reporter=spec \"test/process/**/*.test.ts\"",
    "test:coverage": "node --import tsx --import ./test/setup.ts --test --test-reporter=spec --experimental-test-coverage \"test/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke/run.ts",
    "bench:db": "tsx scripts/bench-db.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/swagger-ui-express": "4.1.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
